{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.parseflow.tech/schemas/usage.json",
  "title": "Parseflow Usage and Quota",
  "description": "Response from GET /v2/usage. Reports rolling 30-day quota consumption for the calling API key.",
  "type": "object",
  "required": ["plan", "requests_used", "requests_limit"],
  "properties": {
    "plan": {
      "type": "string",
      "enum": ["starter", "growth", "byok"]
    },
    "requests_used": { "type": "integer", "minimum": 0 },
    "requests_limit": { "type": "integer", "minimum": 0 },
    "requests_remaining": { "type": "integer", "minimum": 0 },
    "period_start": { "type": "string", "format": "date-time" },
    "period_end": { "type": "string", "format": "date-time" },
    "per_minute_limit": { "type": "integer", "default": 20 },
    "upload_limit_mb": { "type": "integer", "default": 10 }
  }
}
