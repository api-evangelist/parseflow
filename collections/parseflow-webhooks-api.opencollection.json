{
  "opencollection": "1.0.0",
  "info": {
    "name": "parseflow Admin Webhooks API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Whop Webhook V2",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v2/webhooks/whop"
          },
          "docs": "Whop Webhook V2"
        }
      ]
    }
  ],
  "bundled": true
}