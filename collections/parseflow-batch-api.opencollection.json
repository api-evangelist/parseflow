{
  "opencollection": "1.0.0",
  "info": {
    "name": "parseflow Admin Batch API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Batch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Batch V2",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v2/batch",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              },
              {
                "name": "X-Docflow-Gateway-Secret",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Batch V2"
        }
      ]
    }
  ],
  "bundled": true
}