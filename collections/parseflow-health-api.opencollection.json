{
  "opencollection": "1.0.0",
  "info": {
    "name": "parseflow Admin Health API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health V2",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/health"
          },
          "docs": "Health V2"
        },
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "docs": "Health check endpoint for deployment monitoring."
        }
      ]
    }
  ],
  "bundled": true
}